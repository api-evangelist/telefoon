{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telefoon SMS API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefoon.com/v1/sms/messages",
            "params": [
              {
                "name": "direction",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List sent and received messages."
        },
        {
          "info": {
            "name": "Send Message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telefoon.com/v1/sms/messages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send an SMS message with optional branded sender ID."
        },
        {
          "info": {
            "name": "Get Message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefoon.com/v1/sms/messages/:message_id",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get details for a specific message."
        },
        {
          "info": {
            "name": "Delete Message",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telefoon.com/v1/sms/messages/:message_id",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a message record (GDPR right-to-erasure support)."
        }
      ]
    }
  ],
  "bundled": true
}