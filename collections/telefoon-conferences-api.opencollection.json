          },
          "docs": "List conference calls."
        },
        {
          "info": {
            "name": "Create Conference",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telefoon.com/v1/numbers/conferences",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new conference room."
        }
      ]
    }
  ],
  "bundled": true
}