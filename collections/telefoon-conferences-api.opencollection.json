{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telefoon Number Management Available Numbers Conferences API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conferences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
